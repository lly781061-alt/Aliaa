
import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';

class AppDatabase {
  static Database? _database;

  static Future<Database> get database async {
    if (_database != null) return _database!;

    final dbPath = await getDatabasesPath();

    _database = await openDatabase(
      join(dbPath, 'sanbula.db'),
      version: 1,
      onCreate: (db, version) async {

        await db.execute('''
          CREATE TABLE products (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            category TEXT,
            barcode TEXT,
            quantity REAL DEFAULT 0,
            buyPrice REAL DEFAULT 0,
            sellPrice REAL DEFAULT 0,
            image TEXT
          )
        ''');

        await db.execute('''
          CREATE TABLE invoices (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            customer TEXT,
            total REAL,
            paid REAL,
            date TEXT
          )
        ''');

        await db.execute('''
          CREATE TABLE debts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            customer TEXT,
            phone TEXT,
            amount REAL,
            paid REAL DEFAULT 0,
            image TEXT,
            date TEXT
          )
        ''');

        await db.execute('''
          CREATE TABLE rentals (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            customer TEXT,
            equipment TEXT,
            dailyPrice REAL,
            startDate TEXT,
            endDate TEXT,
            status TEXT DEFAULT 'جديد'
          )
        ''');

        await db.execute('''
          CREATE TABLE categories (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            color INTEGER
          )
        ''');
      },
    );

    return _database!;
  }

  static Future<int> addProduct(
    Map<String, dynamic> product
  ) async {
    final db = await database;
    return db.insert('products', product);
  }

  static Future<List<Map<String, dynamic>>>
      getProducts() async {
    final db = await database;
    return db.query('products', orderBy: 'id DESC');
  }

  static Future<int> deleteProduct(int id) async {
    final db = await database;
    return db.delete(
      'products',
      where: 'id = ?',
      whereArgs: [id],
    );
  }

  static Future<int> addDebt(
    Map<String, dynamic> debt
  ) async {
    final db = await database;
    return db.insert('debts', debt);
  }

  static Future<List<Map<String, dynamic>>>
      getDebts() async {
    final db = await database;
    return db.query('debts', orderBy: 'id DESC');
  }

  static Future<int> addRental(
    Map<String, dynamic> rental
  ) async {
    final db = await database;
    return db.insert('rentals', rental);
  }

  static Future<List<Map<String, dynamic>>>
      getRentals() async {
    final db = await database;
    return db.query('rentals', orderBy: 'id DESC');
  }
}
